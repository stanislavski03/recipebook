FROM python:3.12-slim


LABEL maintainer="recipebook" \
      description="RecipeBook API (FastAPI)"


RUN mkdir -p /src/rbk_app
WORKDIR /src/rbk_app


RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*


COPY rbk_api/rbk_requirements.txt /src/rbk_app/rbk_requirements.txt
RUN pip install --no-cache-dir -r rbk_requirements.txt

COPY rbk_api /src/rbk_app
COPY rbk_web /src/rbk_web

EXPOSE 8101

CMD ["uvicorn", "rbk_api:app", "--host", "0.0.0.0", "--port", "8101", "--app-dir", "."]