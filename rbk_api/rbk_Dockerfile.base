# Базовый образ recipebook с ONBUILD-инструкциями.
# Когда от него наследуется другой Dockerfile, инструкции ниже сработают
# автоматически при сборке наследника.

FROM python:3.12-slim

WORKDIR /src/rbk_app

# --- ONBUILD: автоматические шаги для наследников ---
ONBUILD COPY rbk_api/rbk_requirements.txt /src/rbk_app/rbk_requirements.txt
ONBUILD RUN pip install --no-cache-dir -r rbk_requirements.txt
ONBUILD COPY rbk_api /src/rbk_app

CMD ["uvicorn", "rbk_api:app", "--host", "0.0.0.0", "--port", "8101", "--app-dir", "."]